# --- Application -------------------------------------------------------------
APP_ENV=development
APP_NAME=AI Creative Copy Agent
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ----------------------------------------------------------------
# SQLite locally. For a hosted PostgreSQL (e.g. Supabase) paste the connection
# string as given -- postgresql:// is rewritten to the psycopg 3 driver.
DATABASE_URL=sqlite:///./creative_copy.db
# Create tables at startup instead of running migrations. Must be false in production.
AUTO_CREATE_TABLES=true
# Insert development users and taxonomy at startup. Must be false in production.
SEED_ON_STARTUP=true

# --- Security ----------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-secure-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true when serving over HTTPS so the refresh cookie is marked Secure.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_REGISTRATION=true

# --- Google sign-in ----------------------------------------------------------
# Leave empty to disable; the login screen hides the button to match.
# Create a Web application OAuth client at console.cloud.google.com and add
# http://localhost:5173 as an authorised JavaScript origin.
GOOGLE_CLIENT_ID=
# Role granted to accounts created on first Google sign-in.
GOOGLE_DEFAULT_ROLE=marketer

# --- Password reset ----------------------------------------------------------
PASSWORD_RESET_EXPIRE_MINUTES=30
RATE_LIMIT_PASSWORD_RESET=5/hour
# Used to build the reset link inside the email.
FRONTEND_BASE_URL=http://localhost:5173
# This backend's own externally-reachable origin. Used to build absolute media
# URLs (e.g. a generated image) for a test-send email, which can't resolve a
# path relative to the app the way the frontend does.
PUBLIC_BASE_URL=http://localhost:8000
# console | smtp | resend. "console" prints the email instead of sending it,
# which keeps local development credential free. Never use it in production.
EMAIL_PROVIDER=console
EMAIL_FROM=AI Creative Copy Agent <no-reply@example.com>
# Only for EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Only for EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- CORS and limits ---------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUEST_MAX_BYTES=1048576
RATE_LIMIT_GENERATION=20/hour
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_TEST_EMAIL=10/hour

# --- AI provider -------------------------------------------------------------
# mock | gemini. "mock" needs no credentials and is the default for development.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Model identifiers are never hard-coded; set the exact ids from Google AI Studio.
GEMINI_FLASH_MODEL=
GEMINI_PRO_MODEL=
GEMINI_TIMEOUT_SECONDS=60
# Simulated per-stage delay for the mock runtime, in milliseconds.
MOCK_STAGE_DELAY_MS=220

# --- Agent runtime -----------------------------------------------------------
# How many times an agent may be asked to correct output that breaks a content
# rule before the closest attempt is accepted with warnings.
AGENT_RETRIES=2
AGENT_TEMPERATURE=0.8
# Upper bound on model requests within a single agent run.
AGENT_REQUEST_LIMIT=6

# --- LLM-as-Judge ------------------------------------------------------------
# The content validation stage. Uses GEMINI_PRO_MODEL, run cold so verdicts are
# stable. Disabling it skips the stage; copy is still produced.
JUDGE_ENABLED=true
JUDGE_TEMPERATURE=0.1
JUDGE_MIN_SCORE=0.7
# Rewrites attempted when the judge rejects the copy. Copy is never discarded:
# after the last attempt it is returned with warnings.
JUDGE_MAX_REVISIONS=1

# --- Image generation ---------------------------------------------------------
IMAGE_GENERATION_ENABLED=true
# mock | gemini | stability. Independent of AI_PROVIDER -- text and image
# generation can use different backends.
IMAGE_PROVIDER=mock
# Required when IMAGE_PROVIDER=gemini: an image-capable model, e.g. gemini-3-pro-image.
GEMINI_IMAGE_MODEL=
# Required when IMAGE_PROVIDER=stability. Get a key at platform.stability.ai.
STABILITY_API_KEY=
STABILITY_OUTPUT_FORMAT=png
IMAGE_ASPECT_RATIO=1:1
MEDIA_DIR=./media
MEDIA_URL_PREFIX=/media

# --- Grounding ---------------------------------------------------------------
GROUNDING_ENABLED=false
# none | mock | gemini | tavily
GROUNDING_PROVIDER=none

# Tavily (only needed when GROUNDING_PROVIDER=tavily). Get a key at tavily.com.
# One search request is issued per generation.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
# basic costs one credit per search; advanced costs more.
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT_SECONDS=20

# --- Generation behaviour ----------------------------------------------------
REPETITION_SIMILARITY_THRESHOLD=0.82
REPETITION_HISTORY_SIZE=10
GENERATION_TIMEOUT_SECONDS=120

# --- Channel character limits ------------------------------------------------
# SEED DEFAULTS ONLY. Once the database exists, content rules are managed by
# admins in the Rules screen and the `rules` table is authoritative; changing
# these values has no effect on an existing installation.
LIMIT_EMAIL_HEADLINE=80
LIMIT_EMAIL_SUB_HEADING=160
LIMIT_EMAIL_CTA=40
LIMIT_MOBILE_SUPERLINE=30
LIMIT_MOBILE_PRE_HEADING=50
LIMIT_MOBILE_HEADLINE=70
LIMIT_MOBILE_SUB_HEADING=140
LIMIT_MOBILE_CTA=40
LIMIT_SMS_DESCRIPTION=160

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Development seed accounts (local only) ----------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_MARKETER_EMAIL=marketer@example.com
SEED_MARKETER_PASSWORD=ChangeMe123!
