  <diagram id="system-architecture" name="1. System Architecture">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============================ TITLE ============================ -->
        <mxCell id="title" value="AI Creative Copy Agent — System Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Purple = a language model is called · Amber = deterministic, no model · Blue = swappable provider behind an interface" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#667085;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="900" height="20" as="geometry" />
        </mxCell>

        <!-- ============================ CLIENT =========================== -->
        <mxCell id="g1" value="Client — browser" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9AA3BF;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#667085;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="spa" value="&lt;b&gt;React 18 SPA&lt;/b&gt;&lt;br&gt;TypeScript · Material UI&lt;br&gt;React Router · React Hook Form + Zod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F8;strokeColor=#5A6480;strokeWidth=2;fontSize=12;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="apiclient" value="&lt;b&gt;API client (axios)&lt;/b&gt;&lt;br&gt;access token in memory only&lt;br&gt;interceptors: attach, refresh, replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F8;strokeColor=#5A6480;strokeWidth=2;fontSize=12;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="420" y="150" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cookie" value="&lt;b&gt;Refresh token&lt;/b&gt;&lt;br&gt;HttpOnly cookie&lt;br&gt;unreachable from JavaScript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F8;strokeColor=#5A6480;strokeWidth=2;fontSize=12;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="760" y="150" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="gis" value="&lt;b&gt;Google Identity Services&lt;/b&gt;&lt;br&gt;optional — only rendered when&lt;br&gt;the server reports a client id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F8;strokeColor=#5A6480;strokeWidth=2;dashed=1;fontSize=12;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="1100" y="150" width="340" height="90" as="geometry" />
        </mxCell>

        <!-- ============================= EDGE ============================ -->
        <mxCell id="g2" value="Edge — Docker deployment only" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9AA3BF;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#667085;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="1480" height="140" as="geometry" />
        </mxCell>
        <mxCell id="nginx" value="&lt;b&gt;Nginx&lt;/b&gt;&amp;nbsp; serves the built assets · reverse-proxies /api to the backend · CSP and security headers&lt;br&gt;&lt;i&gt;One origin, so the refresh cookie is first-party. In local development the SPA (5173) and API (8000) are two origins joined by CORS.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBFF;strokeColor=#6548E8;strokeWidth=2;fontSize=12;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="80" y="370" width="1400" height="70" as="geometry" />
        </mxCell>

        <!-- =========================== FASTAPI =========================== -->
        <mxCell id="g3" value="FastAPI application — route → service → repository" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9AA3BF;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#667085;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="1480" height="400" as="geometry" />
        </mxCell>
        <mxCell id="mw" value="&lt;b&gt;Middleware&lt;/b&gt;&amp;nbsp; request id · body size limit · security headers · CORS · rate limiting · standard error envelope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF5;strokeColor=#5A6480;strokeWidth=2;fontSize=12;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="80" y="550" width="1400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="rauth" value="&lt;b&gt;Auth routes&lt;/b&gt;&lt;br&gt;login · register · google&lt;br&gt;refresh · logout · me · options&lt;br&gt;password-reset request + confirm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6480;strokeWidth=2;fontSize=11;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="80" y="640" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rgen" value="&lt;b&gt;Generation routes&lt;/b&gt;&lt;br&gt;create · list · detail&lt;br&gt;status · regenerate · delete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6480;strokeWidth=2;fontSize=11;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="430" y="640" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rtax" value="&lt;b&gt;Taxonomy routes&lt;/b&gt;&lt;br&gt;brands · products · segments&lt;br&gt;cta-rules · templates&lt;br&gt;&lt;i&gt;mutations are admin-only&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6480;strokeWidth=2;fontSize=11;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="780" y="640" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rdash" value="&lt;b&gt;Dashboard, logs, system&lt;/b&gt;&lt;br&gt;summary · recent · execution-logs&lt;br&gt;health · ready · system/info" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6480;strokeWidth=2;fontSize=11;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="1130" y="640" width="330" height="90" as="geometry" />
        </mxCell>

        <mxCell id="sauth" value="&lt;b&gt;AuthService&lt;/b&gt;&lt;br&gt;GoogleAuthService · PasswordResetService&lt;br&gt;bcrypt · JWT · token rotation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF5;strokeColor=#5A6480;strokeWidth=2;fontSize=11;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="80" y="770" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sgen" value="&lt;b&gt;GenerationService&lt;/b&gt;&lt;br&gt;builds the WorkflowContext&lt;br&gt;owns the DatabaseRecorder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF5;strokeColor=#5A6480;strokeWidth=2;fontSize=11;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="430" y="770" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="stax" value="&lt;b&gt;Taxonomy repositories&lt;/b&gt;&lt;br&gt;generic CRUD + per-resource queries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF5;strokeColor=#5A6480;strokeWidth=2;fontSize=11;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="780" y="770" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sdash" value="&lt;b&gt;DashboardService&lt;/b&gt;&lt;br&gt;every metric computed from the&lt;br&gt;database — nothing hard-coded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF5;strokeColor=#5A6480;strokeWidth=2;fontSize=11;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="1130" y="770" width="330" height="90" as="geometry" />
        </mxCell>

        <!-- ============================ AGENTS =========================== -->
        <mxCell id="g4" value="Agent pipeline — runs in the background, never imports the ORM" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9AA3BF;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#667085;" vertex="1" parent="1">
          <mxGeometry x="40" y="940" width="1480" height="200" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;1 · Data Extraction&lt;/b&gt;&lt;br&gt;brand, products, SKUs,&lt;br&gt;features, tone, key message&lt;br&gt;&lt;i&gt;flash model&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBFF;strokeColor=#6548E8;strokeWidth=2;fontSize=11;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="70" y="1000" width="225" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;2 · Web Search Grounding&lt;/b&gt;&lt;br&gt;searches only extracted entities&lt;br&gt;&lt;i&gt;optional — failure is recoverable&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6480;strokeWidth=2;dashed=1;fontSize=11;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="310" y="1000" width="225" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;3 · Copy Generation&lt;/b&gt;&lt;br&gt;Email, Mobile and SMS&lt;br&gt;in one structured call&lt;br&gt;&lt;i&gt;quality model&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBFF;strokeColor=#6548E8;strokeWidth=2;fontSize=11;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="550" y="1000" width="225" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;4 · Repetition Fix&lt;/b&gt;&lt;br&gt;rewrites only above the&lt;br&gt;similarity threshold&lt;br&gt;&lt;i&gt;never touches the CTA&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBFF;strokeColor=#6548E8;strokeWidth=2;fontSize=11;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="790" y="1000" width="225" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;5 · CTA Optimisation&lt;/b&gt;&lt;br&gt;highest-priority DB rule whose&lt;br&gt;placeholders all resolve&lt;br&gt;&lt;i&gt;deterministic — no model&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF2E4;strokeColor=#B45309;strokeWidth=2;fontSize=11;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="1030" y="1000" width="225" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="&lt;b&gt;6 · Output Parsing&lt;/b&gt;&lt;br&gt;Pydantic validation, channel&lt;br&gt;limits, timings, persistence&lt;br&gt;&lt;i&gt;deterministic — no model&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF2E4;strokeColor=#B45309;strokeWidth=2;fontSize=11;fontColor=#11182F;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1000" width="225" height="100" as="geometry" />
        </mxCell>

