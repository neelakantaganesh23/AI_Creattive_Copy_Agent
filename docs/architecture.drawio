  <diagram id="lifecycle" name="2. Generation Lifecycle">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="L0" />
        <mxCell id="L1" parent="L0" />

        <mxCell id="Ltitle" value="Generation lifecycle — the POST does not wait for the workflow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#11182F;" vertex="1" parent="L1">
          <mxGeometry x="40" y="20" width="900" height="36" as="geometry" />
        </mxCell>

        <!-- lanes -->
        <mxCell id="lane1" value="Client (SPA)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#C3C9DD;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#667085;spacingTop=6;" vertex="1" parent="L1">
          <mxGeometry x="40" y="80" width="320" height="960" as="geometry" />
        </mxCell>
        <mxCell id="lane2" value="Route handler" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3C9DD;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#667085;spacingTop=6;" vertex="1" parent="L1">
          <mxGeometry x="360" y="80" width="320" height="960" as="geometry" />
        </mxCell>
        <mxCell id="lane3" value="Background worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#C3C9DD;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#667085;spacingTop=6;" vertex="1" parent="L1">
          <mxGeometry x="680" y="80" width="360" height="960" as="geometry" />
        </mxCell>
        <mxCell id="lane4" value="Database" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3C9DD;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#667085;spacingTop=6;" vertex="1" parent="L1">
          <mxGeometry x="1040" y="80" width="320" height="960" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="Marketer submits the brief" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F8;strokeColor=#5A6480;strokeWidth=2;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="70" y="140" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;POST /api/v1/generations&lt;/b&gt;&lt;br&gt;validate · check role · resolve taxonomy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6480;strokeWidth=2;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="390" y="220" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="insert generation (pending)&lt;br&gt;+ six agent_execution rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F6EE;strokeColor=#12734A;strokeWidth=2;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="1070" y="230" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;202 Accepted&lt;/b&gt; — returns immediately" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBFF;strokeColor=#6548E8;strokeWidth=2;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="70" y="320" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;Workflow starts&lt;/b&gt;&lt;br&gt;own DB session · status = running" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBFF;strokeColor=#6548E8;strokeWidth=2;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="710" y="320" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;Stages 1–6&lt;/b&gt;&lt;br&gt;each stage commits its status,&lt;br&gt;duration and model name as it&lt;br&gt;starts and finishes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBFF;strokeColor=#6548E8;strokeWidth=2;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="710" y="430" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="stage rows updated live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F6EE;strokeColor=#12734A;strokeWidth=2;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="1070" y="455" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;GET /generations/{id}/status&lt;/b&gt;&lt;br&gt;polled every ~900 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF2E4;strokeColor=#B45309;strokeWidth=2;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="70" y="600" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="read generation + stage rows&lt;br&gt;compute progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6480;strokeWidth=2;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="390" y="600" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;Stage 6 · Output Parsing&lt;/b&gt;&lt;br&gt;validate, then persist output_json&lt;br&gt;and execution_time_ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF2E4;strokeColor=#B45309;strokeWidth=2;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="710" y="760" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="status = completed&lt;br&gt;(or partial if a stage failed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F6EE;strokeColor=#12734A;strokeWidth=2;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="1070" y="770" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;progress 1.0 · output rendered&lt;/b&gt;&lt;br&gt;polling stops · copy, preview, download" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F8;strokeColor=#5A6480;strokeWidth=2;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="70" y="900" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="Lnote" value="Trade-off: the worker is in-process, so a restart mid-run strands that generation in “running”. A durable queue and a reaper are the production answer." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#B45309;" vertex="1" parent="L1">
          <mxGeometry x="40" y="1055" width="1300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="Le1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5268;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="L1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Le2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5268;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="L1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Le3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6548E8;strokeWidth=3;endArrow=blockThin;endFill=1;" edge="1" parent="L1" source="n2" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Le4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6548E8;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;" edge="1" parent="L1" source="n2" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Le4l" value="hand off after the response is sent" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#4C34C4;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="Le4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Le5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5268;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="L1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Le6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5268;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="L1" source="n6" target="n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Le7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B45309;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;" edge="1" parent="L1" source="n4" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Le8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B45309;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="L1" source="n8" target="n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Le9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B45309;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="L1" source="n9" target="n8">
          <mxGeometry relative="1" as="geometry">
