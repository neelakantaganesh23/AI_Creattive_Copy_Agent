  <diagram id="auth" name="4. Authentication">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="A0" />
        <mxCell id="A1" parent="A0" />

        <mxCell id="Atitle" value="Authentication — three entry paths, one session" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#11182F;" vertex="1" parent="A1">
          <mxGeometry x="40" y="20" width="800" height="36" as="geometry" />
        </mxCell>

        <mxCell id="in1" value="&lt;b&gt;Email + password&lt;/b&gt;&lt;br&gt;bcrypt · constant-time&lt;br&gt;generic error either way" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F8;strokeColor=#5A6480;strokeWidth=2;fontSize=11;" vertex="1" parent="A1">
          <mxGeometry x="40" y="100" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="in2" value="&lt;b&gt;Google ID token&lt;/b&gt;&lt;br&gt;verified against Google's keys&lt;br&gt;auto-provisions as marketer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F8;strokeColor=#5A6480;strokeWidth=2;fontSize=11;" vertex="1" parent="A1">
          <mxGeometry x="40" y="200" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="in3" value="&lt;b&gt;Password reset link&lt;/b&gt;&lt;br&gt;single use · hashed · expiring&lt;br&gt;revokes every session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F8;strokeColor=#5A6480;strokeWidth=2;fontSize=11;" vertex="1" parent="A1">
          <mxGeometry x="40" y="300" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="issue" value="&lt;b&gt;Issue session&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBFF;strokeColor=#6548E8;strokeWidth=2;fontSize=12;" vertex="1" parent="A1">
          <mxGeometry x="400" y="200" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="out1" value="&lt;b&gt;Access token · JWT&lt;/b&gt;&lt;br&gt;response body → JavaScript memory only&lt;br&gt;~30 minutes · never in localStorage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F6EE;strokeColor=#12734A;strokeWidth=2;fontSize=11;" vertex="1" parent="A1">
          <mxGeometry x="700" y="140" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="out2" value="&lt;b&gt;Refresh token · opaque&lt;/b&gt;&lt;br&gt;HttpOnly cookie · only its SHA-256 is stored&lt;br&gt;rotated and revoked on every use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F6EE;strokeColor=#12734A;strokeWidth=2;fontSize=11;" vertex="1" parent="A1">
          <mxGeometry x="700" y="260" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="loopbox" value="Silent refresh — at most once per request" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9AA3BF;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#667085;" vertex="1" parent="A1">
          <mxGeometry x="40" y="450" width="1300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="s1a" value="any API call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6480;strokeWidth=2;fontSize=11;" vertex="1" parent="A1">
          <mxGeometry x="70" y="510" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2a" value="401" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCF2E4;strokeColor=#B45309;strokeWidth=2;fontSize=11;" vertex="1" parent="A1">
          <mxGeometry x="310" y="500" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3a" value="&lt;b&gt;POST /auth/refresh&lt;/b&gt;&lt;br&gt;cookie sent automatically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBFF;strokeColor=#6548E8;strokeWidth=2;fontSize=11;" vertex="1" parent="A1">
          <mxGeometry x="520" y="510" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s4a" value="replay the original request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F6EE;strokeColor=#12734A;strokeWidth=2;fontSize=11;" vertex="1" parent="A1">
          <mxGeometry x="810" y="510" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s5a" value="redirect to /login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6480;strokeWidth=2;fontSize=11;" vertex="1" parent="A1">
          <mxGeometry x="1100" y="510" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="Anote" value="A password change revokes every outstanding refresh token for that user, so all other devices are signed out." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#667085;" vertex="1" parent="A1">
          <mxGeometry x="40" y="660" width="1300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="Ae1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5268;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="A1" source="in1" target="issue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ae2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5268;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="A1" source="in2" target="issue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ae3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5268;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="A1" source="in3" target="issue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ae4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#12734A;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="A1" source="issue" target="out1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ae5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#12734A;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="A1" source="issue" target="out2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ae6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5268;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="A1" source="s1a" target="s2a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ae7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5268;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="A1" source="s2a" target="s3a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ae8" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#12734A;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#12734A;" edge="1" parent="A1" source="s3a" target="s4a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ae9" value="refresh also fails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B45309;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#B45309;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="A1" source="s3a" target="s5a">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="630" y="600" />
              <mxPoint x="1200" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
