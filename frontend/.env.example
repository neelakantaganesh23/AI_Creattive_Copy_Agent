VITE_APP_NAME=AI Creative Copy Agent
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Google sign-in is a placeholder until an OAuth client is configured.
VITE_ENABLE_GOOGLE_LOGIN=false
# Pre-fills the campaign brief form with the sample AeroFlex campaign.
VITE_ENABLE_DEMO_DATA=true
# Milliseconds between generation-status polls.
VITE_POLL_INTERVAL_MS=900
